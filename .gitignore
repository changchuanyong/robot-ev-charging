# This file implements the policy in README.md "Git 跟踪": source, config/,
# dataset/vision/, yolov8n.pt and runs/*/weights/{best,last}.pt are tracked;
# every generated file below is not.

# Python
__pycache__/
*.py[cod]
.venv/

# Editors and OS metadata
.vscode/
Thumbs.db
desktop.ini

# Third-party caches: train/python/runtime_env.py redirects YOLO_CONFIG_DIR,
# MPLCONFIGDIR and the temporary directory into .cache/ so a training run never
# writes outside the project.
.cache/
# Ultralytics label caches written next to the dataset yaml (labels/*.cache).
*.cache

# YOLO training outputs: a run directory is hundreds of megabytes of plots,
# batches and caches that a clone does not need, but the published detector
# weights are the artifact of record. Git cannot re-include a file below an
# excluded directory, so each level is re-included before the two weights are.
runs/*
!runs/*/
runs/*/*
!runs/*/weights/
runs/*/weights/*
!runs/*/weights/best.pt
!runs/*/weights/last.pt

# Live capture sessions and debug/validation output. dataset/vision stays
# tracked on purpose: its images, labels and provenance records are the
# training data of record, and a clone must be able to reproduce it.
dataset/live/
artifacts/

# Process-safe lock state written by vision/training_library.py::_lock: the
# guard file must persist, and .intake/ / .intake-retry/ are lock roots.
.library.guard
.intake/
.intake-retry/

# Local assistant/project notes
.claude/
CLAUDE.md

# Local paper drafts
*.docx

# C/C++ build artifacts
*.obj
*.pdb
*.ilk
*.exe
